# ---------------------------------------------------------------------------
# ReLoop environment configuration.
# Copy to .env.local and fill in values. NEVER commit real credentials.
# Missing AWS values are expected during local development — the app falls
# back to clearly-labelled local adapters (no fake AWS claims).
# `.env.local` is gitignored, so no value here ever reaches version control.
# ---------------------------------------------------------------------------

# --- AWS ---------------------------------------------------------------------
# Region hosting S3, API Gateway, Lambda and DynamoDB.
AWS_REGION=ap-south-1

# DynamoDB table for scan records (single-table design, see src/lib/aws/schema).
RELOOP_SCAN_TABLE=

# Private S3 bucket for uploaded device images (no public access).
RELOOP_IMAGE_BUCKET=

# API Gateway base URL that fronts the analysis Lambda.
# When EMPTY the frontend calls the built-in Next.js route (/api/scans), which
# runs the SAME shared pipeline (src/lib/scan-pipeline) — that is the local
# fallback. Unset this value to return to it.
NEXT_PUBLIC_API_BASE_URL=

# Browser origins the deployed API allows by CORS (comma separated).
RELOOP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# --- AI analysis provider ----------------------------------------------------
# "mock" = deterministic local analysis (development, no AWS needed)
# "bedrock" = Amazon Bedrock (requires credentials + model access)
RELOOP_ANALYSIS_PROVIDER=mock

# Bedrock inference profile used for structured device analysis.
# A direct foundation-model id is rejected — an inference profile is required.
# Verified working in ap-south-1: global.amazon.nova-2-lite-v1:0
RELOOP_BEDROCK_MODEL_ID=

# Region the Bedrock *client* calls. Bedrock model access is granted
# per-region and can differ from AWS_REGION. Empty = same as AWS_REGION.
RELOOP_BEDROCK_REGION=

# --- Behaviour ---------------------------------------------------------------
# Max accepted upload size in bytes (default 8 MiB). Note: API Gateway HTTP
# APIs cap request payloads at 10 MB, so values above that cannot round-trip.
RELOOP_MAX_UPLOAD_BYTES=

# Analysis timeout in milliseconds.
RELOOP_ANALYSIS_TIMEOUT_MS=
