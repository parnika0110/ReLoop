# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# agent/tooling workspace state — NEVER committed
.freebuff/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local image store (dev fallback for S3)
.local-uploads/
.tmp-test/

# one-off Bedrock manual test payload (not app source)
bedrock-image-test.json

# AWS IaC build/deploy output (regenerated by infra/build.mjs + `aws cloudformation package`)
/infra/dist/
/infra/packaged.yaml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
